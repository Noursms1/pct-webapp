FROM python:3.11-slim
RUN pip install --no-cache-dir requests==2.32.0 beautifulsoup4==4.12.3 lxml==5.2.0 pyyaml==6.0.1 jinja2==3.1.4 numpy==1.26.4 pandas==2.2.2 scipy==1.13.0 sympy==1.12 networkx==3.3 cryptography==42.0.7 pycryptodome==3.20.0 dnspython==2.4.0 python-dateutil==2.9.0 tabulate==0.9.0
RUN useradd -m -u 1000 sandbox
WORKDIR /work
USER sandbox
